+static GBTouchZone touch_zone_at(float x, float y) {
+    const GBTouchLayout& l = g_touch_layout;
+    if (!l.valid || y < l.area_top) {
+        return GB_TOUCH_ZONE_NONE;
+    }
+    const float slop = l.ab_r * 0.25f;
+    if (touch_rect_contains(l.menu_rect, x, y, slop)) {
+        return GB_TOUCH_ZONE_MENU;
+    }
+    const float dx = x - l.dpad_x;
+    const float dy = y - l.dpad_y;
+    if (dx * dx + dy * dy <= (l.dpad_r * 1.3f) * (l.dpad_r * 1.3f)) {
+        return GB_TOUCH_ZONE_DPAD;
+    }
+    return GB_TOUCH_ZONE_BUTTONS;
+}
+
+/* Recompute the touch joypad mask and hold actions from all active fingers. */
+static void recompute_touch_inputs(void) {
+    const GBTouchLayout& l = g_touch_layout;
+    uint8_t dpad = 0xFF;
+    uint8_t buttons = 0xFF;
+    bool rewind = false;
+    bool fast_forward = false;
+
+    for (const GBTouchFinger& finger : g_touch_fingers) {
+        if (!finger.active || !l.valid) {
+            continue;
+        }
+        if (finger.zone == GB_TOUCH_ZONE_DPAD) {
+            const float dx = finger.x - l.dpad_x;
+            const float dy = finger.y - l.dpad_y;
+            const float dead = l.dpad_r * 0.18f;
+            if (dx * dx + dy * dy < dead * dead) {
+                continue;
+            }
+            /* 8-way: an axis is active when the finger is within 67.5 degrees
+             * of it (tan(22.5) = 0.4142), so diagonals cover 45-degree arcs. */
+            const float ax = std::fabs(dx);
+            const float ay = std::fabs(dy);
+            if (ax > ay * 0.4142f) {
+                dpad &= (uint8_t)~(dx > 0.0f ? 0x01 : 0x02);
+            }
+            if (ay > ax * 0.4142f) {
+                dpad &= (uint8_t)~(dy > 0.0f ? 0x08 : 0x04);
+            }
+        } else if (finger.zone == GB_TOUCH_ZONE_BUTTONS) {
+            const float hit = l.ab_r * 1.35f;
+            const float adx = finger.x - l.a_x;
+            const float ady = finger.y - l.a_y;
+            const float bdx = finger.x - l.b_x;
+            const float bdy = finger.y - l.b_y;
+            if (adx * adx + ady * ady <= hit * hit) buttons &= (uint8_t)~0x01;
+            if (bdx * bdx + bdy * bdy <= hit * hit) buttons &= (uint8_t)~0x02;
+            const float slop = l.ab_r * 0.25f;
+            if (touch_rect_contains(l.select_rect, finger.x, finger.y, slop)) buttons &= (uint8_t)~0x04;
+            if (touch_rect_contains(l.start_rect, finger.x, finger.y, slop)) buttons &= (uint8_t)~0x08;
+            if (touch_rect_contains(l.rewind_rect, finger.x, finger.y, slop)) rewind = true;
+            if (touch_rect_contains(l.ff_rect, finger.x, finger.y, slop)) fast_forward = true;
+        }
+    }
+
+    g_touch_joypad_dpad = dpad;
+    g_touch_joypad_buttons = buttons;
+    g_touch_rewind_held = rewind;
+    g_touch_fast_forward_held = fast_forward;
+}
+
+/* Re-evaluate the layout once per presented frame; resizes, rotation and
+ * controller hot-plug all flow through here. */
+static void refresh_touch_layout_state(void) {
+    const bool active = touch_layout_active();
+    if (active != g_touch_layout_applied) {
+        g_touch_layout_applied = active;
+        clear_touch_state();
+        update_effective_joypad_state();
+        update_game_viewport();
+    }
+    if (g_show_menu && (g_touch_joypad_dpad != 0xFF || g_touch_joypad_buttons != 0xFF ||
+                        g_touch_rewind_held || g_touch_fast_forward_held)) {
+        clear_touch_state();
+        update_effective_joypad_state();
+    }
+}
