+/* True when the portrait touch layout owns the lower part of the window. */
+static bool touch_layout_active(void) {
+    if (!g_window || g_benchmark_mode || !touch_controls_enabled()) {
+        return false;
+    }
+    int window_w = 0;
+    int window_h = 0;
+    SDL_GetWindowSize(g_window, &window_w, &window_h);
+    return window_w > 0 && window_h > window_w;
+}
+
+static bool touch_rect_contains(const GBTouchRect& rect, float x, float y, float slop) {
+    return x >= rect.x - slop && x <= rect.x + rect.w + slop &&
+           y >= rect.y - slop && y <= rect.y + rect.h + slop;
+}
+
+static void compute_touch_layout(void) {
+    g_touch_layout = {};
+    if (!touch_layout_active()) {
+        return;
+    }
+    int window_w = 0;
+    int window_h = 0;
+    SDL_GetWindowSize(g_window, &window_w, &window_h);
+    const float w = (float)window_w;
+    const float top = (float)(g_game_viewport.y + g_game_viewport.h);
+    const float area_h = (float)window_h - top;
+    if (area_h < 80.0f) {
+        return;
+    }
+
+    GBTouchLayout& l = g_touch_layout;
+    l.valid = true;
+    l.area_top = top;
+    l.area_h = area_h;
+
+    l.dpad_r = std::fmin(w * 0.20f, area_h * 0.28f);
+    l.dpad_x = w * 0.25f;
+    l.dpad_y = top + area_h * 0.47f;
+
+    l.ab_r = std::fmin(w * 0.095f, area_h * 0.12f);
+    l.a_x = w * 0.84f;
+    l.a_y = top + area_h * 0.38f;
+    l.b_x = w * 0.64f;
+    l.b_y = top + area_h * 0.52f;
+
+    const float small_w = w * 0.15f;
+    const float small_h = std::fmax(area_h * 0.06f, 24.0f);
+    const float pill_y = top + area_h * 0.84f;
+    l.select_rect = { w * 0.40f - small_w * 0.5f, pill_y, small_w, small_h };
+    l.start_rect = { w * 0.60f - small_w * 0.5f, pill_y, small_w, small_h };
