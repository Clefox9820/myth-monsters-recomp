+
+static void draw_touch_controls(void) {
+    const GBTouchLayout& l = g_touch_layout;
+    if (!g_touch_layout_applied || !l.valid || g_show_menu) {
+        return;
+    }
+    ImDrawList* dl = ImGui::GetBackgroundDrawList();
+    const ImU32 base = IM_COL32(255, 255, 255, 40);
+    const ImU32 lit = IM_COL32(255, 255, 255, 120);
+    const ImU32 edge = IM_COL32(255, 255, 255, 90);
+    const ImU32 label = IM_COL32(255, 255, 255, 210);
+
+    /* D-pad: a plus shape with each arm lit while pressed. */
+    const float arm = l.dpad_r * 0.36f;
+    const float r = l.dpad_r;
+    const float cx = l.dpad_x;
+    const float cy = l.dpad_y;
+    dl->AddCircleFilled(ImVec2(cx, cy), r * 1.05f, IM_COL32(255, 255, 255, 18), 48);
+    dl->AddRectFilled(ImVec2(cx - arm, cy - arm), ImVec2(cx + arm, cy + arm), base);
+    const struct { uint8_t bit; float x0, y0, x1, y1; const char* text; float lx, ly; } arms[] = {
+        { 0x04, cx - arm, cy - r, cx + arm, cy - arm, "^", cx, cy - (r + arm) * 0.5f },
+        { 0x08, cx - arm, cy + arm, cx + arm, cy + r, "v", cx, cy + (r + arm) * 0.5f },
+        { 0x02, cx - r, cy - arm, cx - arm, cy + arm, "<", cx - (r + arm) * 0.5f, cy },
+        { 0x01, cx + arm, cy - arm, cx + r, cy + arm, ">", cx + (r + arm) * 0.5f, cy },
+    };
+    for (const auto& a : arms) {
+        const bool pressed = !(g_touch_joypad_dpad & a.bit);
+        dl->AddRectFilled(ImVec2(a.x0, a.y0), ImVec2(a.x1, a.y1), pressed ? lit : base, arm * 0.3f);
+        draw_touch_label(dl, a.lx, a.ly, arm * 1.1f, label, a.text);
+    }
+    dl->AddCircle(ImVec2(cx, cy), r * 1.05f, edge, 48, 2.0f);
+
+    /* A and B */
+    const bool a_pressed = !(g_touch_joypad_buttons & 0x01);
+    const bool b_pressed = !(g_touch_joypad_buttons & 0x02);
+    dl->AddCircleFilled(ImVec2(l.a_x, l.a_y), l.ab_r, a_pressed ? lit : base, 40);
+    dl->AddCircle(ImVec2(l.a_x, l.a_y), l.ab_r, edge, 40, 2.0f);
+    draw_touch_label(dl, l.a_x, l.a_y, l.ab_r * 0.9f, label, "A");
+    dl->AddCircleFilled(ImVec2(l.b_x, l.b_y), l.ab_r, b_pressed ? lit : base, 40);
+    dl->AddCircle(ImVec2(l.b_x, l.b_y), l.ab_r, edge, 40, 2.0f);
+    draw_touch_label(dl, l.b_x, l.b_y, l.ab_r * 0.9f, label, "B");
+
+    draw_touch_rect_button(dl, l.select_rect, !(g_touch_joypad_buttons & 0x04), "SELECT");
+    draw_touch_rect_button(dl, l.start_rect, !(g_touch_joypad_buttons & 0x08), "START");
+    draw_touch_rect_button(dl, l.rewind_rect, g_touch_rewind_held, "<< REW");
+    draw_touch_rect_button(dl, l.ff_rect, g_touch_fast_forward_held, "FF >>");
+    draw_touch_rect_button(dl, l.menu_rect, false, "MENU");
+}
