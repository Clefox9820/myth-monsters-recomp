+static size_t rewind_memory_bytes(void) {
+    size_t total = 0;
+    for (int i = 0; i < GB_REWIND_CAPACITY; ++i) {
+        if (g_rewind_slots[i]) {
+            total += g_rewind_state_size;
+        }
+    }
+    return total;
+}
+
+/* Runs once per completed guest frame, between gb_run_cycles() calls (the
+ * same boundary used by manual savestates). While the Rewind action is held
+ * each frame restores the newest snapshot and drops it, so playback runs
+ * backwards at GB_REWIND_SNAPSHOT_INTERVAL x speed; the oldest snapshot is
+ * kept so holding past the buffer start freezes there. */
+static void rewind_on_guest_frame(GBContext* ctx) {
+    const bool want_rewind = g_rewind_enabled && ctx != NULL && !g_benchmark_mode &&
+        !g_show_menu &&
+        (g_runtime_action_pressed[GB_INPUT_ACTION_REWIND] || g_touch_rewind_held);
+
+    if (want_rewind) {
+        g_rewind_active.store(true, std::memory_order_relaxed);
+        g_rewind_frame_counter = 0;
+        if (g_rewind_count > 0) {
+            const int index = (g_rewind_head + GB_REWIND_CAPACITY - 1) % GB_REWIND_CAPACITY;
+            if (g_rewind_slots[index] &&
+                gb_context_load_state_buffer(ctx, g_rewind_slots[index], g_rewind_state_size)) {
+                g_last_frame_time = SDL_GetTicks();
+            }
+            if (g_rewind_count > 1) {
+                g_rewind_head = index;
+                g_rewind_count--;
+            }
+        }
+        reset_audio_output_buffer(true);
+        return;
+    }
+
+    if (g_rewind_active.load(std::memory_order_relaxed)) {
+        g_rewind_active.store(false, std::memory_order_relaxed);
+        reset_audio_output_buffer(true);
+    }
+    if (!g_rewind_enabled || ctx == NULL || g_benchmark_mode) {
+        return;
+    }
+    if (++g_rewind_frame_counter < GB_REWIND_SNAPSHOT_INTERVAL) {
+        return;
+    }
+    g_rewind_frame_counter = 0;
+
+    const size_t state_size = gb_context_state_size(ctx);
+    if (state_size == 0) {
+        return;
+    }
+    if (state_size != g_rewind_state_size) {
+        rewind_clear(true);
+        g_rewind_state_size = state_size;
+    }
+    uint8_t*& slot = g_rewind_slots[g_rewind_head];
+    if (!slot) {
+        slot = (uint8_t*)malloc(state_size);
+        if (!slot) {
+            return; /* Out of memory: keep the snapshots we already have. */
+        }
+    }
+    if (!gb_context_save_state_buffer(ctx, slot, state_size, NULL)) {
+        return;
+    }
+    g_rewind_head = (g_rewind_head + 1) % GB_REWIND_CAPACITY;
+    if (g_rewind_count < GB_REWIND_CAPACITY) {
+        g_rewind_count++;
+    }
+}
