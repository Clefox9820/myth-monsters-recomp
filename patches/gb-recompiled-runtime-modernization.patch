+ * ========================================================================== */
+/* Fraction of a portrait window reserved for the game image. */
+static constexpr float GB_TOUCH_GAME_AREA_FRACTION = 0.60f;
+static constexpr int GB_TOUCH_MAX_FINGERS = 10;
+
+typedef enum GBTouchZone {
+    GB_TOUCH_ZONE_NONE = 0,
+    GB_TOUCH_ZONE_DPAD = 1,
+    GB_TOUCH_ZONE_BUTTONS = 2,
+    GB_TOUCH_ZONE_MENU = 3,
