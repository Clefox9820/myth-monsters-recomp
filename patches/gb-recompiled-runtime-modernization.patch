+    if (free_memory) {
+        for (int i = 0; i < GB_REWIND_CAPACITY; ++i) {
+            free(g_rewind_slots[i]);
+            g_rewind_slots[i] = NULL;
+        }
+        g_rewind_state_size = 0;
+    }
