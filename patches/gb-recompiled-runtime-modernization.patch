+    draw_list->AddRectFilled(ImVec2(rect.x, rect.y), ImVec2(rect.x + rect.w, rect.y + rect.h),
+                             fill, rect.h * 0.5f);
+    draw_list->AddRect(ImVec2(rect.x, rect.y), ImVec2(rect.x + rect.w, rect.y + rect.h),
+                       IM_COL32(255, 255, 255, 90), rect.h * 0.5f, 0, 2.0f);
