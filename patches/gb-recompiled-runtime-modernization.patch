+ * @brief Size in bytes of a full snapshot of @p ctx (same format as the
+ *        savestate file), or 0 when the context is not ready.
+ */
+size_t gb_context_state_size(const GBContext* ctx);
+
+/**
+ * @brief Serialize a full snapshot into a caller-provided buffer
+ * @param ctx Source context
+ * @param buffer Destination, at least gb_context_state_size(ctx) bytes
+ * @param capacity Size of @p buffer
+ * @param out_size Optional; receives the number of bytes written
+ * @return true on success
+ */
