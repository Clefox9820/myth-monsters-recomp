+static void handle_touch_finger_event(const SDL_Event* event, GBContext* ctx,
+                                      bool dpad_selected, bool buttons_selected) {
+    if (!g_touch_layout_applied || !g_touch_layout.valid || g_show_menu || !g_window) {
+        return;
+    }
+    int window_w = 0;
+    int window_h = 0;
+    SDL_GetWindowSize(g_window, &window_w, &window_h);
+    const float x = event->tfinger.x * (float)window_w;
+    const float y = event->tfinger.y * (float)window_h;
+    const SDL_FingerID id = event->tfinger.fingerId;
+
+    GBTouchFinger* finger = NULL;
+    for (GBTouchFinger& candidate : g_touch_fingers) {
+        if (candidate.active && candidate.id == id) {
+            finger = &candidate;
+            break;
+        }
+    }
+
+    if (event->type == SDL_FINGERDOWN) {
+        const GBTouchZone zone = touch_zone_at(x, y);
+        if (zone == GB_TOUCH_ZONE_NONE) {
+            return;
+        }
+        if (zone == GB_TOUCH_ZONE_MENU) {
+            g_show_menu = true;
+            clear_touch_state();
+            update_effective_joypad_state();
+            update_runtime_action_state(ctx);
+            return;
+        }
+        if (!finger) {
+            for (GBTouchFinger& candidate : g_touch_fingers) {
+                if (!candidate.active) {
+                    finger = &candidate;
+                    break;
+                }
+            }
+        }
+        if (!finger) {
+            return;
+        }
+        finger->active = true;
+        finger->id = id;
+        finger->zone = zone;
+        finger->x = x;
+        finger->y = y;
+    } else if (!finger) {
+        return;
+    } else if (event->type == SDL_FINGERMOTION) {
+        finger->x = x;
+        finger->y = y;
+    } else {
+        *finger = {};
+    }
+
+    const uint8_t previous_dpad = g_joypad_dpad;
+    const uint8_t previous_buttons = g_joypad_buttons;
+    recompute_touch_inputs();
+    update_effective_joypad_state();
+    update_runtime_action_state(ctx);
+    const bool port_captured = dispatch_captured_port_input(
+        ctx, previous_dpad, previous_buttons);
+    if (ctx && !port_captured &&
+        input_transition_creates_press(previous_dpad,
+                                       previous_buttons,
+                                       g_joypad_dpad,
+                                       g_joypad_buttons,
+                                       dpad_selected,
+                                       buttons_selected)) {
